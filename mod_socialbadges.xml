<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="3.1.0" client="site" method="upgrade">
    <name>Social Badges</name>
    <author>Michael Allen</author>
    <version>6.0.0</version>
    <description>Displays social badges.</description>
    <files>
        <filename>index.html</filename>
        <filename>mod_socialbadges.xml</filename>
        <filename module="mod_socialbadges">mod_socialbadges.php</filename>
        <filename>helper.php</filename>
        <folder>media</folder>
        <folder>tmpl</folder>
    </files>
		<config>
			<fields name="params">
				<fieldset name="basic">
					<field
						name="contact"
						type="menuitem"
						label="Contact"
						description="">
						<option	value="">JNONE</option>
					</field>
					<field
						name="about"
						type="menuitem"
						label="Info/About"
						description="" >
						<option	value="">JNONE</option>
					</field>

					<field name="badges1"
						type="repeatable"
						icon="list"
						description=""
						label="Badges"
						default="">
						<fieldset hidden="true" name="badges_modal1" repeat="true">
							<field name="type" type="list" default="" label="Social Badge" description="">
								<option value="facebook">Facebook</option>
								<option value="flickr">Flickr</option>
								<option value="google">Google</option>
								<option value="instagram">Instagram</option>
								<option value="linkedin">LinkedIn</option>
								<option value="pinterest">Pinterest</option>
								<option value="twitter">Twitter</option>
								<option value="youtube">Youtube</option>
							</field>
							<field
								name="id1"
								type="text"
								label="User ID"
								description="" />
						</fieldset>
					</field>						

<field
    name="badge_list"
    type="subform"
    label="Badges"
    description=""
    multiple="true"
    layout="joomla.form.field.subform.repeatable"
>

    <form>
        <fields name="badge_fields">
            <field
                name="type"
                type="list"
                label="Social Badge"
                default=""
            >
                <option value="facebook">Facebook</option>
                <option value="flickr">Flickr</option>
                <option value="google">Google</option>
                <option value="instagram">Instagram</option>
                <option value="linkedin">LinkedIn</option>
                <option value="pinterest">Pinterest</option>
                <option value="twitter">Twitter</option>
                <option value="youtube">YouTube</option>
            </field>

            <field
                name="id"
                type="text"
                label="User ID"
            />
        </fields>
    </form>

</field>



				</fieldset>
				<fieldset
					name="advanced">
					<field
						name="moduleclass_sfx"
						type="textarea" rows="3"
						label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
						description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC" />
				<field
					name="layout"
					type="modulelayout"
					label="JFIELD_ALT_LAYOUT_LABEL"
					description="JFIELD_ALT_MODULE_LAYOUT_DESC"
				/>
				</fieldset>


			</fields>	
		</config>
</extension>
